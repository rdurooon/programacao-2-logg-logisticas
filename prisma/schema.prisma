generator client {
    provider = "prisma-client-js"
    previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
    provider   = "postgresql"
    url        = env("DATABASE_URL")
    extensions = [postgis, uuid_ossp(map: "uuid-ossp")]
}

model User {
    id        String   @id @default(uuid())
    name      String
    email     String   @unique
    password  String

    roles     Role[]   @relation("users_roles")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("users")
}

model Pessoa {
    id            String          @id @default(uuid())
    tipoPessoa    String

    pessoaFisica  PessoaFisica?
    pessoaJuridica PessoaJuridica?
    cliente       Cliente?

    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt

    @@map("pessoas")
}

model PessoaFisica {
    pessoaId   String   @id
    cpf        String
    nome       String
    rg         String?

    pessoa     Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@map("pessoas_fisicas")
}

model PessoaJuridica {
    pessoaId    String   @id
    cnpj        String
    razaoSocial String
    inscricaoEstadual String?

    pessoa      Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Cascade)

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("pessoas_juridicas")
}

model Cliente {
    id        String    @id @default(uuid())
    pessoaId  String    @unique

    pessoa    Pessoa    @relation(fields: [pessoaId], references: [id], onDelete: Cascade)
    packages  Package[]
    addresses Address[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    @@map("clientes")
}

model Role {
    id        String   @id @default(uuid())
    name      String   @unique

    users     User[]   @relation("users_roles")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("roles")
}

model Package {
    id          String   @id @default(uuid())
    code        String   @unique
    description String
    dimensions  String
    weight      Float

    clienteId   String
    addressId   String

    cliente     Cliente  @relation(fields: [clienteId], references: [id])
    address     Address  @relation(fields: [addressId], references: [id])

    status      String   @default("Pendente")

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@map("packages")
}

model Address {
    id           String    @id @default(uuid())
    clienteId    String
    cep          String
    logradouro   String
    numero       String
    complemento  String
    bairro       String
    cidade       String
    estado       String
    pais         String

    cliente      Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
    packages     Package[]

    @@map("address")
}

model Enterprise {
    id        String   @id @default(uuid())
    name      String
    cnpj      String
    telefone  String

    @@map("enterprises")
}